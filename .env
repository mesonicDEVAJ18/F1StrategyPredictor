# Pipeline settings, read by scripts/env_config.py (diagnostic.md #22).
# Values for the reference weekend (Bahrain 2025, FP1-FP3). No secrets: this file is committed.
# An environment variable with the same name overrides the value here.
# Paths are relative to scripts/, where the pipeline is run from.

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
DATA_DIR=../data
RESULTS_ROOT=./results

# Subfolders of DATA_DIR: raw OpenF1 downloads per source, and the pipeline's hand-off files
LAPS_DIR=raw/laps
STINTS_DIR=raw/stints
WEATHER_DIR=raw/weather
CARDATA_DIR=raw/car_data
PROCESSED_DIR=processed

# Raw OpenF1 downloads (in LAPS_DIR, STINTS_DIR, WEATHER_DIR, CARDATA_DIR)
LAPS_FILES=laps_p1.csv,laps_p2.csv,laps_p3.csv
STINTS_FILES=stints_p1.csv,stints_p2.csv,stints_p3.csv
WEATHER_FILE=weather.csv
LAPS_GLOB=laps_p*.csv
# Car data: one file per session and driver (car_data_p<session>_<driver>.csv)
CARDATA_GLOB=car_data_p*_*.csv

# Hand-off files between stages (in PROCESSED_DIR)
LAPS_CLEAN_FILE=laps_combined_clean.csv
STINTS_CLEAN_FILE=stints_combined_clean.csv
WEATHER_CLEAN_FILE=cleaned_weather.csv
CARDATA_CLEAN_FILE=cardata_per_lap_clean.csv
ENGINEERED_FILE=final_engineered_dataset.csv
TYRE_SETS_FILE=tyre_sets_race_inventory.csv

# Model bundle written by train_model.py, read by strategy_simulator.py / validate_strategy.py
MODEL_BUNDLE_PATH=./results/train_model/train_model_xgb_model.pkl

# ------------------------------------------------------------
# Lap cleaning (process_laps.py)
# ------------------------------------------------------------
# Laps at or under this many seconds are dropped
LAP_MIN_DURATION_S=30
# Laps at or over this multiple of the session median are dropped
LAP_MAX_MEDIAN_MULTIPLE=2
# Laps with any speed trap (i1, i2, st) at or under this km/h are dropped
MIN_SPEED_KMH=50
# Window (laps) of the per-driver rolling median used for the residual filter
ROLLING_MEDIAN_WINDOW=5
# Residuals outside Q1 - k*IQR .. Q3 + k*IQR are dropped
IQR_MULTIPLIER=3
# Non-push laps (cool-down, in-, traffic laps) are dropped: laps over this multiple of the
# driver's best lap in the session (#20). Cleaned laps split into push/long-run laps at
# <= 1.10x and cool-down laps from ~1.3x, with a gap around 1.14-1.16x
PUSH_LAP_MAX_BEST_RATIO=1.15

# ------------------------------------------------------------
# Weather (process_weather.py, feature_engineer.py)
# ------------------------------------------------------------
# Weather rows with |z| above this are dropped
WEATHER_ZSCORE_THRESHOLD=3
# Max gap between a lap's date_start and its nearest weather sample (pandas Timedelta string)
WEATHER_MERGE_TOLERANCE=5min

# ------------------------------------------------------------
# Car data (process_cardata.py)
# ------------------------------------------------------------
# brake/throttle value meaning "no valid input" (car stationary / in the garage)
CARDATA_NO_INPUT_VALUE=104
# drs status codes that mean the flap is open
CARDATA_DRS_OPEN_CODES=10,12,14
# Laps with fewer than this fraction of the expected samples are dropped
CARDATA_MIN_COVERAGE=0.5
# Throttle (%) at or above which a sample counts as full throttle
CARDATA_FULL_THROTTLE_MIN=99
# Per-session |z| above this on any per-lap aggregate drops the lap
CARDATA_ZSCORE_THRESHOLD=3
# Readings above these are physically impossible and dropped
CARDATA_MAX_SPEED_KMH=400
CARDATA_MAX_RPM=16000
CARDATA_MAX_GEAR=8

# ------------------------------------------------------------
# Tyre sets (tyre_sets.py, strategy_simulator.py; #21)
# ------------------------------------------------------------
# Race cars simulated, each with its own set inventory
RACE_CARS=16,44
# Practice stand-ins as driver:race car (Bearman #38 ran Leclerc's #16 car in FP1)
FP_STAND_INS=38:16
# Dry sets per car for the weekend, as compound:count
TYRE_ALLOCATION=SOFT:8,MEDIUM:3,HARD:2
# Sets handed back after the 1st, 2nd and 3rd practice session (most-worn first;
# an assumption, check the season's sporting regulations)
TYRE_RETURNS_PER_SESSION=1,1,2
# New sets per compound kept for the race, never returned (mandatory race sets)
TYRE_RACE_RESERVED=HARD:1,MEDIUM:1

# ------------------------------------------------------------
# Fuel correction (feature_config.py)
# ------------------------------------------------------------
# k in fuel_corrected_pace = lap_duration - k * laps_remaining, laps_remaining = lap_end - lap_number + 1 (s per lap, see #19)
FUEL_EFFECT_K=0.035

# ------------------------------------------------------------
# Modelling (train_model.py, validate_strategy.py)
# ------------------------------------------------------------
RANDOM_STATE=42
# Held-out share of rows in train_model.py
TEST_SIZE=0.20
# Folds in validate_strategy.py
CV_FOLDS=5
RF_N_ESTIMATORS=200
XGB_N_ESTIMATORS=300
XGB_LEARNING_RATE=0.05
XGB_MAX_DEPTH=7
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE_BYTREE=0.8

# ------------------------------------------------------------
# Race / strategy simulator (strategy_simulator.py)
# ------------------------------------------------------------
NUM_LAPS=57
# Time lost to one pit stop (s)
PIT_LOSS_S=22.0
# Race fuel penalty (s per lap of fuel on board); separate from FUEL_EFFECT_K
FUEL_PENALTY_PER_LAP=0.035
# Pit laps are drawn from PIT_WINDOW_START_LAP .. NUM_LAPS - PIT_WINDOW_END_BUFFER - 1
PIT_WINDOW_START_LAP=10
PIT_WINDOW_END_BUFFER=10
# Numbers of stops enumerated (0 stops can't use two compounds, so it is left out)
STOP_COUNTS=1,2
# Fewest distinct compounds a race strategy must use (dry-race two-compound rule, #8)
MIN_COMPOUNDS_USED=2
# Stint laps logged in the rollout smoothness check (NUM_LAPS is always added); 18 is past the longest stint age in training (13 since #20)
SMOOTHNESS_CHECK_AGES=1,18
